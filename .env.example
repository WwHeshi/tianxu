# Copy this file to .env before running Docker Compose.
# PowerShell: Copy-Item .env.example .env

COMPOSE_PROJECT_NAME=tianxu

# PostgreSQL (the defaults are for local development only)
POSTGRES_DB=tianxu
POSTGRES_USER=tianxu
POSTGRES_PASSWORD=tianxu_dev_password
POSTGRES_PORT=5432

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# The URL used by the backend container. The hostname is the Compose service name.
COMPOSE_DATABASE_URL=postgresql+asyncpg://tianxu:tianxu_dev_password@postgres:5432/tianxu
# Use this URL when running FastAPI directly on the host instead of in Docker.
DATABASE_URL=postgresql+asyncpg://tianxu:tianxu_dev_password@localhost:5432/tianxu

# Browser-visible API URL (this is compiled into the Next.js client bundle).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Comma-separated origins, if the backend enables CORS validation.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Reserved for the Agent phase. The current backend does not call a model.
MODEL_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
