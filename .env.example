# Optional local-development overrides.
# The project starts without a .env file; copy this file only when changing defaults.

FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# If a frontend/backend port changes, update the related URL/origin too.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model settings are writable only when this server-side switch is enabled.
MODEL_SETTINGS_ENABLED=true

# Development-only example. Replace it before storing a real API key.
# The decoded master key must be exactly 32 bytes; never expose it as NEXT_PUBLIC_*.
APP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_ENCRYPTION_KEY_VERSION=v1
